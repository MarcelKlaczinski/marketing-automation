# Node
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://marketing_auto:dev_password_change_me@localhost:5432/marketing_auto

# Redis — shared with local Vanilla v3 instance (no separate container needed)
# BullMQ queues are isolated by name, so sharing is safe.
REDIS_URL=redis://localhost:6379

# API
API_PORT=3050
API_HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3051

# Encryption (Spec 02) - REQUIRED at startup. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# External APIs (Phase 2+)
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Email / SMTP (Spec 11.5)
# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME="Marketing Automation"
# Default to Gmail. Override for SES/Mailgun/Hetzner SMTP/etc:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Web Push (Spec 41) - generate with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:marcel@example.com

# Cloudflare R2 storage (Spec 12)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: custom domain (https://assets.example.com). If unset, falls back to R2's pub URL.
R2_PUBLIC_BASE_URL=


# Google PageSpeed Insights API (Spec 22.5) - optional
# Get key at https://console.cloud.google.com/apis/credentials
# Without key: 400 requests/day. With key: 25,000 requests/day (free)
PAGESPEED_INSIGHTS_API_KEY=
