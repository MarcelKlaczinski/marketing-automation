{
  "name": "@marketing-auto/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file ../../.env --hot src/server.ts",
    "start": "bun --env-file ../../.env src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=./dist",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && bun test apps/api/test",
    "add-user": "bun --env-file ../../.env src/scripts/add-user.ts",
    "add-project": "bun --env-file ../../.env src/scripts/add-project.ts",
    "sync-context": "bun --env-file ../../.env src/scripts/sync-context.ts",
    "worker": "bun --env-file ../../.env src/workers/index.ts",
    "worker:dev": "bun --env-file ../../.env --hot src/workers/index.ts",
    "cold-start:voice-refinement": "bun --env-file ../../.env src/scripts/cold-start/01-voice-refinement.ts",
    "cold-start:competitor-analysis": "bun --env-file ../../.env src/scripts/cold-start/02-competitor-analysis.ts",
    "cold-start:cluster-plan": "bun --env-file ../../.env src/scripts/cold-start/03-cluster-plan.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "@marketing-auto/adapter-email": "workspace:*",
    "@marketing-auto/db": "workspace:*",
    "@marketing-auto/pipelines": "workspace:*",
    "@marketing-auto/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  }
}
