{
  "name": "@marketing-auto/db",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "bun --env-file ../../.env node_modules/.bin/drizzle-kit generate",
    "migrate": "bun --env-file ../../.env src/migrate.ts",
    "studio": "drizzle-kit studio",
    "push": "drizzle-kit push",
    "test": "cd ../.. && bun test packages/db/test",
    "typecheck": "tsc --noEmit",
    "seed-platform": "bun --env-file ../../.env src/scripts/seed-platform.ts"
  },
  "dependencies": {
    "@marketing-auto/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0"
  }
}
