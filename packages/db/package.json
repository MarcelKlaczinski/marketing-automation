{
  "name": "@marketing-auto/db",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --env-file ../../.env",
    "migrate": "bun --env-file ../../.env src/migrate.ts",
    "studio": "drizzle-kit studio --env-file ../../.env",
    "push": "drizzle-kit push --env-file ../../.env",
    "check": "drizzle-kit check --env-file ../../.env",
    "test": "cd ../.. && bun test packages/db/test",
    "typecheck": "tsc --noEmit",
    "seed-platform": "bun --env-file ../../.env src/scripts/seed-platform.ts",
    "migrate:custom": "bun --env-file ../../.env",
    "verify:brand-tokens-schema": "bun --env-file ../../.env migrations/scripts/verify-brand-tokens-schema.ts"
  },
  "dependencies": {
    "@marketing-auto/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0"
  }
}
